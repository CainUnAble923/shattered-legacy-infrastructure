# Path to the ModernUO server directory on the host
SERVER_PATH=D:/ShatteredLegacy/server

# Path to UO classic client data files (maps, art, tiledata, etc.)
CLIENT_DATA_PATH=D:/ShatteredLegacy/client-data/classic-client

# Test shard only (docker-compose.test.yml). Unset, the test shard uses CLIENT_DATA_PATH.
# cc-P36: a copy of EA's 7.0.117.0 install; never point either variable at UltimaOnlineVanilla itself.
CLIENT_DATA_PATH_TEST=D:/ShatteredLegacy/client-data/classic-client-7.0.117.0

# Your domain registered on Cloudflare
DOMAIN=shatteredlegacyuo.com

# Cloudflare Zone ID (found in the domain's Overview page on Cloudflare dashboard)
CF_ZONE_ID=your_zone_id_here

# Cloudflare API Token (Zone:DNS:Edit permission for shatteredlegacyuo.com)
CF_API_TOKEN=your_api_token_here

# Timezone for the server process
TZ=America/Chicago
