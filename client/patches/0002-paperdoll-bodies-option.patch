diff --git a/src/ClassicUO.Assets/ExternalImageLoader.cs b/src/ClassicUO.Assets/ExternalImageLoader.cs
index e321c5436..66714ca8d 100644
--- a/src/ClassicUO.Assets/ExternalImageLoader.cs
+++ b/src/ClassicUO.Assets/ExternalImageLoader.cs
@@ -81,7 +81,9 @@ namespace ClassicUO.Assets
 
         public GumpInfo LoadGumpTexture(uint graphic)
         {
-            if (!gump_availableFilePaths.TryGetValue(graphic, out string fullImagePath))
+            // Shattered Legacy (cc-P111): a run-time override, read from where it is (never copied into ExternalImages).
+            if (!gump_overridePaths.TryGetValue(graphic, out string fullImagePath) &&
+                !gump_availableFilePaths.TryGetValue(graphic, out fullImagePath))
                 return new GumpInfo();
 
             if (gump_textureCache.TryGetValue(graphic, out (uint[] pixels, int width, int height) cached))
@@ -585,6 +587,32 @@ namespace ClassicUO.Assets
 
         public void ClearGumpPixelCache(uint graphic) => gump_textureCache.Remove(graphic);
 
+        // Shattered Legacy (cc-P111): gump ids drawn from a file outside ExternalImages, by full path, ahead of both the
+        // ExternalImages folder and the client's own gumps. Replaces the whole set; returns every id whose source changed
+        // (added, removed or moved), with its cached pixels dropped, so the caller can redraw exactly those.
+        private readonly Dictionary<uint, string> gump_overridePaths = new Dictionary<uint, string>();
+
+        public List<uint> SetGumpOverrides(IReadOnlyDictionary<uint, string> overrides)
+        {
+            var changed = new List<uint>();
+            foreach (KeyValuePair<uint, string> old in gump_overridePaths)
+                if (overrides == null || !overrides.TryGetValue(old.Key, out string now) || now != old.Value)
+                    changed.Add(old.Key);
+            if (overrides != null)
+                foreach (KeyValuePair<uint, string> now in overrides)
+                    if (!gump_overridePaths.ContainsKey(now.Key))
+                        changed.Add(now.Key);
+            gump_overridePaths.Clear();
+            if (overrides != null)
+                foreach (KeyValuePair<uint, string> now in overrides)
+                    gump_overridePaths[now.Key] = now.Value;
+            foreach (uint id in changed)
+                gump_textureCache.Remove(id);
+            return changed;
+        }
+
+        public string GetGumpOverride(uint graphic) => gump_overridePaths.TryGetValue(graphic, out string p) ? p : null;
+
         public void ClearAllPixelCaches()
         {
             art_textureCache.Clear();
