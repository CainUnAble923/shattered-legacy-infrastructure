@@ -1,5 +1,9 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
 using ClassicUO.Common;
 using ClassicUO.Configuration;
+using ClassicUO.Game.Managers;
 using ClassicUO.Game.UI.Gumps;
 using ClassicUO.Game.UI.MyraWindows.Widgets;
 
@@ -12,10 +16,32 @@ public class PaperdollTab
     internal static IOptionSource GetContent()
     {
         return OptionsUi.Vertical(
+            GetShatteredLegacySection(),
             GetModernPaperdollSection()
         ).WithSearch(new SearchMetadata(TazLang.Get("mog_buttonpaperdoll"), [TazLang.Get("mog_kw_paperdoll"), TazLang.Get("mog_kw_character"), TazLang.Get("mog_kw_equipment")]));
     }
 
+    // Shattered Legacy (cc-P111): Paperdoll bodies. SFW always; Topless and Nude listed only when the local add-on folder
+    // holds that set's six bodies (PaperdollBodies.Available), so without the add-on this lists SFW alone. Applies live.
+    private static OptionFragment GetShatteredLegacySection()
+    {
+        List<string> sets = PaperdollBodies.Available(PaperdollBodies.Folder);
+        string current = PaperdollBodies.Effective(Settings.GlobalSettings.SlPaperdollBodies, PaperdollBodies.Folder);
+        string[] labels = sets.Select(PaperdollBodies.Label).ToArray();
+
+        return OptionsUi.VisualContainer(
+            new VisualContainerProps { LabelText = "Shattered Legacy" },
+            Option.ComboBox(
+                "Paperdoll bodies",
+                Math.Max(0, sets.IndexOf(current)),
+                labels,
+                i => PaperdollBodies.Choose(sets[Math.Clamp(i, 0, sets.Count - 1)]),
+                tooltip: "The art of the paperdoll body. Changes at once, also on an open paperdoll.",
+                search: new SearchMetadata("Paperdoll bodies", Keywords: ["paperdoll", "body", "shattered legacy"])
+            )
+        );
+    }
+
     private static OptionFragment GetModernPaperdollSection()
     {
         Profile profile = ProfileManager.CurrentProfile;
