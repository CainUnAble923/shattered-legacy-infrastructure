diff --git a/tests/ClassicUO.UnitTests/Game/PaperdollBodiesTests.cs b/tests/ClassicUO.UnitTests/Game/PaperdollBodiesTests.cs
new file mode 100644
index 000000000..298ba3a8a
--- /dev/null
+++ b/tests/ClassicUO.UnitTests/Game/PaperdollBodiesTests.cs
@@ -0,0 +1,130 @@
+// Shattered Legacy patch (cc-P111): the Paperdoll bodies option. The add-on folders here hold empty stand-in files named
+// like the bodies: the option only checks that all six exist, and no art is ever needed (or allowed) in a test.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text.Json;
+using ClassicUO.Assets;
+using ClassicUO.Configuration;
+using ClassicUO.Game.Managers;
+using FluentAssertions;
+using Xunit;
+
+namespace ClassicUO.UnitTests.Game
+{
+    public class PaperdollBodiesTests : IDisposable
+    {
+        private readonly string _root = Path.Combine(Path.GetTempPath(), "sl-paperdoll-" + Guid.NewGuid().ToString("N"));
+
+        public void Dispose()
+        {
+            if (Directory.Exists(_root))
+                Directory.Delete(_root, true);
+        }
+
+        private string MakeSet(string folder, string set, params uint[] ids)
+        {
+            string dir = Path.Combine(folder, set);
+            Directory.CreateDirectory(dir);
+            foreach (uint id in ids)
+                File.WriteAllBytes(Path.Combine(dir, id + ".png"), Array.Empty<byte>());
+            return dir;
+        }
+
+        [Fact]
+        public void The_bodies_are_cc_P81s_six()
+        {
+            PaperdollBodies.BodyIds.Should().Equal(12u, 13u, 14u, 15u, 665u, 666u);
+        }
+
+        [Fact]
+        public void Without_the_add_on_only_SFW_is_offered()
+        {
+            PaperdollBodies.Available(null).Should().Equal("sfw");
+            PaperdollBodies.Available(Path.Combine(_root, "missing")).Should().Equal("sfw");
+            PaperdollBodies.ResolveFolder(null, Path.Combine(_root, "client")).Should().BeNull();
+        }
+
+        [Fact]
+        public void A_set_with_all_six_bodies_is_offered()
+        {
+            string folder = Path.Combine(_root, "paperdoll-nsfw");
+            MakeSet(folder, "topless", PaperdollBodies.BodyIds);
+            MakeSet(folder, "nude", PaperdollBodies.BodyIds);
+            PaperdollBodies.Available(folder).Should().Equal("sfw", "topless", "nude");
+        }
+
+        [Fact]
+        public void A_set_missing_one_body_is_not_offered_and_falls_back_to_SFW()
+        {
+            string folder = Path.Combine(_root, "paperdoll-nsfw");
+            MakeSet(folder, "topless", PaperdollBodies.BodyIds);
+            MakeSet(folder, "nude", 12, 13, 14, 15, 665);
+            PaperdollBodies.Available(folder).Should().Equal("sfw", "topless");
+            PaperdollBodies.Effective("nude", folder).Should().Be("sfw");
+            PaperdollBodies.Overrides("nude", folder).Should().BeEmpty();
+        }
+
+        [Fact]
+        public void The_chosen_set_is_read_from_the_add_on_folder_where_it_is()
+        {
+            string folder = Path.Combine(_root, "paperdoll-nsfw");
+            string dir = MakeSet(folder, "nude", PaperdollBodies.BodyIds);
+            Dictionary<uint, string> o = PaperdollBodies.Overrides("nude", folder);
+            o.Keys.Should().BeEquivalentTo(PaperdollBodies.BodyIds);
+            o[665].Should().Be(Path.Combine(dir, "665.png"));
+            PaperdollBodies.Overrides("sfw", folder).Should().BeEmpty("SFW draws the shipped PNGs");
+            PaperdollBodies.Overrides("bogus", folder).Should().BeEmpty();
+        }
+
+        [Fact]
+        public void The_folder_is_the_configured_one_else_beside_the_client_or_the_install()
+        {
+            string install = Path.Combine(_root, "install");
+            string client = Path.Combine(install, "app", "tazuo");
+            Directory.CreateDirectory(client);
+            PaperdollBodies.ResolveFolder("", client).Should().BeNull();
+
+            string atInstall = Path.Combine(install, "client-addons", "paperdoll-nsfw");
+            Directory.CreateDirectory(atInstall);
+            PaperdollBodies.ResolveFolder("", client).Should().Be(Path.GetFullPath(atInstall), "<client>\\..\\..: cc-P81's place");
+
+            string besideClient = Path.Combine(install, "app", "client-addons", "paperdoll-nsfw");
+            Directory.CreateDirectory(besideClient);
+            PaperdollBodies.ResolveFolder("", client).Should().Be(Path.GetFullPath(besideClient), "<client>\\.. first");
+
+            string named = Path.Combine(_root, "elsewhere");
+            Directory.CreateDirectory(named);
+            PaperdollBodies.ResolveFolder(named, client).Should().Be(named);
+            PaperdollBodies.ResolveFolder(Path.Combine(_root, "gone"), client).Should().BeNull("a named folder that is gone is no add-on");
+        }
+
+        [Fact]
+        public void The_choice_persists_in_the_global_settings_file_and_defaults_to_SFW()
+        {
+            new Settings().SlPaperdollBodies.Should().Be("sfw");
+
+            var s = new Settings { SlPaperdollBodies = "topless", SlPaperdollFolder = @"D:\addons" };
+            string json = JsonSerializer.Serialize(s, SettingsJsonContext.RealDefault.Settings);
+            json.Should().Contain("\"sl_paperdoll_bodies\"").And.Contain("\"sl_paperdoll_folder\"");
+            Settings back = JsonSerializer.Deserialize(json, SettingsJsonContext.RealDefault.Settings);
+            back.SlPaperdollBodies.Should().Be("topless");
+            back.SlPaperdollFolder.Should().Be(@"D:\addons");
+
+            Settings old = JsonSerializer.Deserialize("{\"ip\":\"127.0.0.1\"}", SettingsJsonContext.RealDefault.Settings);
+            old.SlPaperdollBodies.Should().Be("sfw", "a settings file from before the option reads as SFW");
+        }
+
+        [Fact]
+        public void Overrides_win_over_the_folder_and_report_exactly_the_bodies_that_changed()
+        {
+            var loader = new ExternalImageLoader();
+            loader.SetGumpOverrides(new Dictionary<uint, string> { [12] = "a12", [13] = "a13" }).Should().BeEquivalentTo(new uint[] { 12, 13 });
+            loader.GetGumpOverride(12).Should().Be("a12");
+            loader.SetGumpOverrides(new Dictionary<uint, string> { [12] = "a12", [13] = "b13" }).Should().BeEquivalentTo(new uint[] { 13 });
+            loader.SetGumpOverrides(new Dictionary<uint, string>()).Should().BeEquivalentTo(new uint[] { 12, 13 }, "back to SFW redraws both");
+            loader.GetGumpOverride(12).Should().BeNull();
+            loader.SetGumpOverrides(null).Should().BeEmpty();
+        }
+    }
+}
