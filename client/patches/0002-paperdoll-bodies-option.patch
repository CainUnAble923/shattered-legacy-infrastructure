@@ -58,5 +58,13 @@ namespace ClassicUO.Renderer.Gumps
         }
 
         public bool PixelCheck(uint idx, int x, int y, double scale = 1f) => _picker.Get(idx, x, y, scale: scale);
+
+        // Shattered Legacy (cc-P111): forget one gump's sprite, so the next draw loads it again (from an override, a PNG
+        // or the client's files). Its old atlas space is not reclaimed: a few small bodies per switch.
+        public void Invalidate(uint idx)
+        {
+            if (idx < _spriteInfos.Length)
+                _spriteInfos[idx] = default;
+        }
     }
