diff --git a/src/ClassicUO.Client/Game/Managers/PaperdollBodies.cs b/src/ClassicUO.Client/Game/Managers/PaperdollBodies.cs
new file mode 100644
index 000000000..43cd21f34
--- /dev/null
+++ b/src/ClassicUO.Client/Game/Managers/PaperdollBodies.cs
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: BSD-2-Clause
+// Shattered Legacy patch (cc-P111): the "Paperdoll bodies" option, SFW, Topless or Nude.
+//
+// The shipped client draws the six paperdoll body gumps from ExternalImages\gumps\<id>.png, the SFW set (cc-P81).
+// Topless and Nude exist only in a local add-on folder that never ships: <folder>\topless\<id>.png and
+// <folder>\nude\<id>.png. A set is offered only when its folder holds all six bodies, so without the add-on the option
+// shows SFW alone and names nothing else. The chosen set's files are read where they are, at run time
+// (ExternalImageLoader.SetGumpOverrides); nothing is copied into ExternalImages, the client folder or a build.
+//
+// Purely client-side: no packet, no server flag; other players see nothing different.
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+using ClassicUO.Assets;
+using ClassicUO.Configuration;
+using ClassicUO.Utility.Logging;
+
+namespace ClassicUO.Game.Managers
+{
+    internal static class PaperdollBodies
+    {
+        public const string Sfw = "sfw", Topless = "topless", Nude = "nude";
+
+        // The six body gumps: male and female, and the two gargoyle bodies (cc-P81, player-package\vendor\paperdoll-sos\bodies-sfw).
+        public static readonly uint[] BodyIds = { 12, 13, 14, 15, 665, 666 };
+
+        private static readonly string[] _addonSets = { Topless, Nude };
+
+        public static string Label(string set) => set switch
+        {
+            Topless => "Topless",
+            Nude => "Nude",
+            _ => "SFW"
+        };
+
+        /// <summary>The add-on folder: the configured one if it is set, else the first of
+        /// <client>\..\client-addons\paperdoll-nsfw and <client>\..\..\client-addons\paperdoll-nsfw that exists
+        /// (the second is the player install's own folder, beside app\, where cc-P81's launcher looks). Null if none.</summary>
+        public static string ResolveFolder(string configured, string clientDir)
+        {
+            if (!string.IsNullOrWhiteSpace(configured))
+                return Directory.Exists(configured) ? configured : null;
+
+            if (string.IsNullOrEmpty(clientDir))
+                return null;
+
+            foreach (string up in new[] { "..", Path.Combine("..", "..") })
+            {
+                string candidate = Path.GetFullPath(Path.Combine(clientDir, up, "client-addons", "paperdoll-nsfw"));
+                if (Directory.Exists(candidate))
+                    return candidate;
+            }
+
+            return null;
+        }
+
+        /// <summary>The six body files of one add-on set, by gump id, or null unless all six are there.</summary>
+        public static Dictionary<uint, string> SetFiles(string folder, string set)
+        {
+            if (folder == null || Array.IndexOf(_addonSets, set) < 0)
+                return null;
+
+            var files = new Dictionary<uint, string>();
+            foreach (uint id in BodyIds)
+            {
+                string path = Path.Combine(folder, set, id + ".png");
+                if (!File.Exists(path))
+                    return null;
+                files[id] = path;
+            }
+
+            return files;
+        }
+
+        /// <summary>SFW always, then each add-on set whose folder holds all six bodies.</summary>
+        public static List<string> Available(string folder)
+        {
+            var sets = new List<string> { Sfw };
+            foreach (string set in _addonSets)
+                if (SetFiles(folder, set) != null)
+                    sets.Add(set);
+            return sets;
+        }
+
+        /// <summary>The set that is drawn: the chosen one if it is available, else SFW (a missing body falls back).</summary>
+        public static string Effective(string chosen, string folder) =>
+            Available(folder).Contains(chosen) ? chosen : Sfw;
+
+        /// <summary>The overrides for a choice: the add-on set's six files, or none (SFW: the shipped PNGs).</summary>
+        public static Dictionary<uint, string> Overrides(string chosen, string folder) =>
+            SetFiles(folder, Effective(chosen, folder)) ?? new Dictionary<uint, string>();
+
+        public static string Folder => ResolveFolder(Settings.GlobalSettings.SlPaperdollFolder, AppContext.BaseDirectory);
+
+        /// <summary>Applies the saved choice: at start (before anything is drawn) and after the option changes. Every body
+        /// whose source changed is dropped from the gump atlas, so an open paperdoll redraws with the new set next frame.</summary>
+        public static void Apply()
+        {
+            string folder = Folder;
+            string chosen = Settings.GlobalSettings.SlPaperdollBodies ?? Sfw;
+            string effective = Effective(chosen, folder);
+            if (effective != chosen)
+                Log.Info($"Paperdoll bodies: '{chosen}' is not available here, drawing SFW.");
+
+            List<uint> changed = ExternalImageLoader.Instance.SetGumpOverrides(Overrides(chosen, folder));
+            var gumps = Client.Game?.UO?.Gumps;
+            if (gumps != null)
+                foreach (uint id in changed)
+                    gumps.Invalidate(id);
+        }
+
+        /// <summary>The option's choice: saved at once (not only at exit) and applied live.</summary>
+        public static void Choose(string set)
+        {
+            Settings.GlobalSettings.SlPaperdollBodies = set;
+            Settings.GlobalSettings.Save();
+            Apply();
+        }
+    }
+}
diff --git a/src/ClassicUO.Client/Game/UI/MyraWindows/Options/Tabs/PaperdollTab.cs b/src/ClassicUO.Client/Game/UI/MyraWindows/Options/Tabs/PaperdollTab.cs
