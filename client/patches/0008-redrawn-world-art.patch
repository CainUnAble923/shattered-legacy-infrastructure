diff --git a/src/ClassicUO.Client/Game/Managers/SlRedrawnArt.cs b/src/ClassicUO.Client/Game/Managers/SlRedrawnArt.cs
new file mode 100644
index 000000000..fb4362cf0
--- /dev/null
+++ b/src/ClassicUO.Client/Game/Managers/SlRedrawnArt.cs
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: BSD-2-Clause
+// Shattered Legacy patch (cc-P670): "Redrawn world art (Zigholtul)", an opt-in look in Options > Interface > Appearance,
+// off by default.
+//
+// Zigholtul's "UO Art Static Replacements for TazUO" redraw stock statics (fuller trees, crisper furniture, chests and
+// crystals). The player package ships the ones that sit on their tiles as stock does (shard-migration
+// notes/cc-P670-tools/fit.py) in ExternalImages\sl-redrawn-art\<item ID>.png: a folder TazUO never loads by itself, so
+// a client with the box unticked draws exactly the stock art. Ticked, each covered item ID is drawn from its PNG
+// (ExternalImageLoader.SetArtRedrawn, after a UI skin's remap and before the ID's own ExternalImages\art PNG). Client
+// side only: no packet, no server flag; other players see their own choice. Tiledata (height, light, animation) is the
+// stock file's either way: only the picture changes.
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+using ClassicUO.Assets;
+using ClassicUO.Configuration;
+
+namespace ClassicUO.Game.Managers
+{
+    internal static class SlRedrawnArt
+    {
+        public const string FolderName = "sl-redrawn-art";
+
+        private static string _scannedFolder;
+        private static Dictionary<uint, string> _scanned;
+
+        /// <summary>The package's folder: ExternalImages\sl-redrawn-art beside TazUO.exe.</summary>
+        public static string DefaultFolder => Path.Combine(AppContext.BaseDirectory, "ExternalImages", FolderName);
+
+        /// <summary>Every PNG in the folder (not its subfolders) named by a plain decimal item ID, keyed by art index
+        /// (item ID + 0x4000). Any other name ("3308 vines.png", "0x0C8E.png") is not ours to guess at and is skipped.</summary>
+        public static Dictionary<uint, string> Scan(string folder)
+        {
+            var map = new Dictionary<uint, string>();
+            if (string.IsNullOrEmpty(folder) || !Directory.Exists(folder))
+                return map;
+            foreach (string file in Directory.GetFiles(folder, "*.png", SearchOption.TopDirectoryOnly))
+            {
+                string name = Path.GetFileNameWithoutExtension(file);
+                if (name.Length == 0 || name.Length > 5)
+                    continue;
+                bool digits = true;
+                foreach (char c in name)
+                    digits &= c >= '0' && c <= '9';
+                if (digits && uint.TryParse(name, out uint id) && id < 0x10000)
+                    map[id + 0x4000] = file;
+            }
+            return map;
+        }
+
+        /// <summary>The table to draw from: the folder's PNGs when on, nothing when off.</summary>
+        public static Dictionary<uint, string> Paths(bool on, string folder)
+        {
+            if (!on)
+                return new Dictionary<uint, string>();
+            if (_scanned == null || _scannedFolder != folder)
+            {
+                _scanned = Scan(folder);
+                _scannedFolder = folder;
+            }
+            return new Dictionary<uint, string>(_scanned);
+        }
+
+        /// <summary>Whether this client has the art at all (the option is offered only then).</summary>
+        public static bool Installed => Scan(DefaultFolder).Count > 0;
+
+        /// <summary>Applies the current profile's choice: at login (World.CreatePlayer, after the profile loads) and when
+        /// the box changes. Every art index whose source changed is dropped from the atlas, so the world redraws with the
+        /// new look on the next frame; no restart.</summary>
+        public static void Apply()
+        {
+            bool on = ProfileManager.CurrentProfile?.SlRedrawnArt ?? false;
+            List<uint> changed = ExternalImageLoader.Instance.SetArtRedrawn(Paths(on, DefaultFolder));
+            var uo = Client.Game?.UO;
+            if (uo?.Arts != null)
+                foreach (uint idx in changed)
+                    uo.Arts.Invalidate(idx);
+        }
+
+        /// <summary>The option's choice: saved in the profile at once and applied live.</summary>
+        public static void Choose(bool on)
+        {
+            Profile profile = ProfileManager.CurrentProfile;
+            if (profile == null)
+                return;
+            profile.SlRedrawnArt = on;
+            Apply();
+        }
+    }
+}
