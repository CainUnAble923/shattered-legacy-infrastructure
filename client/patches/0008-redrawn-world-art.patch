diff --git a/tests/ClassicUO.UnitTests/Game/SlRedrawnArtTests.cs b/tests/ClassicUO.UnitTests/Game/SlRedrawnArtTests.cs
new file mode 100644
index 000000000..c0b33ece8
--- /dev/null
+++ b/tests/ClassicUO.UnitTests/Game/SlRedrawnArtTests.cs
@@ -0,0 +1,94 @@
+// Shattered Legacy patch (cc-P670): the opt-in redrawn world art (Game\Managers\SlRedrawnArt.cs, the redrawn table in
+// ExternalImageLoader, the Appearance tab's checkbox). The folders here hold empty stand-in files named like the IDs:
+// the table only needs to know a file is there, and no art is ever needed (or allowed) in a test.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using ClassicUO.Assets;
+using ClassicUO.Game.Managers;
+using FluentAssertions;
+using Xunit;
+
+namespace ClassicUO.UnitTests.Game
+{
+    public class SlRedrawnArtTests : IDisposable
+    {
+        private readonly string _root = Path.Combine(Path.GetTempPath(), "sl-redrawn-" + Guid.NewGuid().ToString("N"));
+
+        public void Dispose()
+        {
+            ExternalImageLoader.Instance.SetArtRedrawn(null);
+            ExternalImageLoader.Instance.SetArtRemap(null);
+            if (Directory.Exists(_root))
+                Directory.Delete(_root, true);
+        }
+
+        private string Folder(params string[] names)
+        {
+            string dir = Path.Combine(_root, SlRedrawnArt.FolderName);
+            Directory.CreateDirectory(dir);
+            foreach (string n in names)
+                File.WriteAllBytes(Path.Combine(dir, n), Array.Empty<byte>());
+            return dir;
+        }
+
+        [Fact]
+        public void The_folder_is_its_own_and_is_never_one_TazUO_loads_by_itself()
+        {
+            SlRedrawnArt.FolderName.Should().Be("sl-redrawn-art");
+            SlRedrawnArt.FolderName.Should().NotBe("art").And.NotBe("gumps");
+        }
+
+        [Fact]
+        public void Scan_takes_only_PNGs_named_by_a_plain_decimal_item_ID_keyed_by_art_index()
+        {
+            string dir = Folder("3274.png", "6001.png", "3308 vines.png", "0x0C8E.png", "notes.txt", "12252.png");
+            File.WriteAllBytes(Path.Combine(dir, "nested.png"), Array.Empty<byte>());
+            Directory.CreateDirectory(Path.Combine(dir, "sub"));
+            File.WriteAllBytes(Path.Combine(dir, "sub", "4000.png"), Array.Empty<byte>());
+
+            Dictionary<uint, string> map = SlRedrawnArt.Scan(dir);
+
+            map.Keys.Should().BeEquivalentTo(new uint[] { 3274 + 0x4000, 6001 + 0x4000, 12252 + 0x4000 });
+            map[3274 + 0x4000].Should().Be(Path.Combine(dir, "3274.png"));
+            SlRedrawnArt.Scan(Path.Combine(_root, "missing")).Should().BeEmpty();
+        }
+
+        [Fact]
+        public void Off_is_stock_on_draws_the_redraw_and_switching_names_every_ID_to_redraw()
+        {
+            string dir = Folder("3274.png", "3275.png");
+            ExternalImageLoader loader = ExternalImageLoader.Instance;
+            uint a = 3274 + 0x4000, b = 3275 + 0x4000;
+
+            loader.ResolveArtPath(a).Should().BeNull("off by default: the client's own art");
+
+            List<uint> on = loader.SetArtRedrawn(SlRedrawnArt.Paths(true, dir));
+            on.Should().BeEquivalentTo(new[] { a, b });
+            loader.ResolveArtPath(a).Should().Be(Path.Combine(dir, "3274.png"));
+
+            loader.SetArtRedrawn(SlRedrawnArt.Paths(true, dir)).Should().BeEmpty("nothing changed");
+
+            List<uint> off = loader.SetArtRedrawn(SlRedrawnArt.Paths(false, dir));
+            off.Should().BeEquivalentTo(new[] { a, b });
+            loader.ResolveArtPath(a).Should().BeNull();
+            SlRedrawnArt.Paths(false, dir).Should().BeEmpty();
+        }
+
+        [Fact]
+        public void A_UI_skins_remap_still_wins_over_a_redraw()
+        {
+            string dir = Folder("7981.png");
+            string images = Path.Combine(_root, "images");
+            Directory.CreateDirectory(Path.Combine(images, "art"));
+            File.WriteAllBytes(Path.Combine(images, "art", "13049.png"), Array.Empty<byte>());
+            ExternalImageLoader loader = ExternalImageLoader.Instance;
+            loader.ScanImages(images);
+
+            loader.SetArtRedrawn(SlRedrawnArt.Paths(true, dir));
+            loader.SetArtRemap(new Dictionary<uint, uint> { [7981 + 0x4000] = 13049 + 0x4000 });
+
+            loader.ResolveArtPath(7981 + 0x4000).Should().Be(Path.Combine(images, "art", "13049.png"));
+        }
+    }
+}
