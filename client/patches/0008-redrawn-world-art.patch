diff --git a/src/ClassicUO.Assets/ExternalImageLoader.cs b/src/ClassicUO.Assets/ExternalImageLoader.cs
index cc43da57b..8d0d1a3e4 100644
--- a/src/ClassicUO.Assets/ExternalImageLoader.cs
+++ b/src/ClassicUO.Assets/ExternalImageLoader.cs
@@ -663,15 +663,43 @@ namespace ClassicUO.Assets
             return gump_availableFilePaths.TryGetValue(graphic, out p) ? p : null;
         }
 
-        /// <summary>The file an art index (item ID + 0x4000) is drawn from: a skin's remap, the ID's own PNG; null for
-        /// the client's own art.</summary>
+        /// <summary>The file an art index (item ID + 0x4000) is drawn from: a skin's remap, the redrawn world art when it
+        /// is on (cc-P670), the ID's own PNG; null for the client's own art.</summary>
         public string ResolveArtPath(uint graphic)
         {
             if (art_skinRemap.TryGetValue(graphic, out uint to) && art_availableFilePaths.TryGetValue(to, out string p))
                 return p;
+            // cc-P670: then the redrawn world art, while it is on.
+            if (art_redrawnPaths.TryGetValue(graphic, out p))
+                return p;
             return art_availableFilePaths.TryGetValue(graphic, out p) ? p : null;
         }
 
+        // Shattered Legacy (cc-P670): the opt-in redrawn world art. Art indexes (item ID + 0x4000) drawn from a PNG outside
+        // ExternalImages\art (the package's ExternalImages\sl-redrawn-art, which TazUO never loads by itself), only while
+        // the player has ticked it. Replaces the whole table; returns every index whose source changed, its cached pixels
+        // dropped, so the caller redraws exactly those. Null or empty turns it off: stock art again.
+        private readonly Dictionary<uint, string> art_redrawnPaths = new Dictionary<uint, string>();
+
+        public List<uint> SetArtRedrawn(IReadOnlyDictionary<uint, string> paths)
+        {
+            var changed = new List<uint>();
+            foreach (KeyValuePair<uint, string> old in art_redrawnPaths)
+                if (paths == null || !paths.TryGetValue(old.Key, out string now) || now != old.Value)
+                    changed.Add(old.Key);
+            if (paths != null)
+                foreach (KeyValuePair<uint, string> now in paths)
+                    if (!art_redrawnPaths.ContainsKey(now.Key))
+                        changed.Add(now.Key);
+            art_redrawnPaths.Clear();
+            if (paths != null)
+                foreach (KeyValuePair<uint, string> now in paths)
+                    art_redrawnPaths[now.Key] = now.Value;
+            foreach (uint id in changed)
+                art_textureCache.Remove(id);
+            return changed;
+        }
+
         public string GetGumpFilePath(uint graphic) => gump_availableFilePaths.TryGetValue(graphic, out string p) ? p : null;
 
         public string GetArtFilePath(uint graphic) => art_availableFilePaths.TryGetValue(graphic, out string p) ? p : null;
