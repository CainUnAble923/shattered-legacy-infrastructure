+    public const string RedrawnArtLabel = "Redrawn world art (Zigholtul)";
+
+    // cc-P670: one checkbox. Off is the stock art, exactly; on draws each covered world item from Zigholtul's PNG.
+    private static OptionContent RedrawnArtRow()
+    {
+        bool installed = SlRedrawnArt.Installed;
+        return Option.Checkbox(
+            RedrawnArtLabel,
+            installed && (ProfileManager.CurrentProfile?.SlRedrawnArt ?? false),
+            on => SlRedrawnArt.Choose(installed && on),
+            tooltip: installed
+                ? "Fuller trees, crisper furniture, chests and crystals, redrawn by Zigholtul. Only you see it. Changes at once; no restart."
+                : "Not installed in this client: the world is drawn with the stock art.",
+            search: new SearchMetadata(RedrawnArtLabel, Keywords: ["redrawn", "world art", "trees", "zigholtul", "appearance"])
+        );
+    }
