     #region Draw
 
+    // Shattered Legacy patch (cc-P240, F-6): the fog of war layer, one texel per 8x8 chunk (ShardFogOfWar), drawn over
+    // the map texture around the same world point, with the same rotation and pixels per tile, so it lines up at every
+    // zoom, flipped or not. Only when the shard sent fog for this facet and the menu's "Fog of war" is on.
+    private void DrawFog(UltimaBatcher2D batcher, int screenX, int screenY, int centerX, int centerY, int size, int size_zoom, int size_zoom_half, Vector3 hueVector)
+    {
+        if (!_showFog || _map == null || !ShardFogOfWar.HasData(_map.Index))
+        {
+            return;
+        }
+
+        Texture2D fog = ShardFogOfWar.Texture(Client.Game.GraphicsDevice, _map.Index);
+        if (fog == null)
+        {
+            return;
+        }
+
+        const int chunk = ShardFogOfWar.ChunkSize;
+        float worldCenterX = centerX - size_zoom_half + size_zoom / 2f;
+        float worldCenterY = centerY - size_zoom_half + size_zoom / 2f;
+        int chunkX = (int)Math.Floor((centerX - size_zoom_half) / (float)chunk) - 1;
+        int chunkY = (int)Math.Floor((centerY - size_zoom_half) / (float)chunk) - 1;
+        int chunks = size_zoom / chunk + 3;
+        float scale = chunk * size / (float)size_zoom;
+
+        batcher.Draw
+        (
+            fog,
+            new Vector2(screenX, screenY),
+            new Rectangle(chunkX, chunkY, chunks, chunks),
+            hueVector,
+            _flipMap ? Microsoft.Xna.Framework.MathHelper.ToRadians(45) : 0,
+            new Vector2((worldCenterX - chunkX * chunk) / chunk, (worldCenterY - chunkY * chunk) / chunk),
+            new Vector2(scale, scale),
+            SpriteEffects.None,
+            0
+        );
+    }
