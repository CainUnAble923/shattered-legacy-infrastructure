+++ b/src/ClassicUO.Client/Network/EnhancedPackets/ShardButtons.cs
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: BSD-2-Clause
+// Shattered Legacy patch (cc-P147): shard buttons. A button on the paperdoll or the top bar asks the server for one of
+// its own pages (Achievements first), through enhanced packet 4, ClientCommand, in the other direction.
+//
+// Client -> server: HEADER (ushort id 4), then the command as null-terminated ASCII (for example "achievements"). The
+// bare HEADER with no command stays cc-P103's acknowledgement. The server answers only a client that acknowledged id 4
+// and only a command on its own list, so the buttons show only after the server's EnableEnhancedPacket asked for id 4
+// on this connection: a stock TazUO never has them, and our client shows none on a shard that did not ask.
+//
+// One entry per button: the command the server knows, its label, and the paperdoll gumps (0: not on the paperdoll).
+
+using System;
+using ClassicUO.IO;
+
+namespace ClassicUO.Network;
+
+public static class ShardButtons
+{
+    public sealed class Entry
+    {
+        public Entry(string command, string label, ushort normal = 0, ushort pressed = 0, ushort hover = 0)
+        {
+            Command = command;
+            Label = label;
+            Normal = normal;
+            Pressed = pressed;
+            Hover = hover;
+        }
+
+        public string Command { get; }
+        public string Label { get; }
+        public ushort Normal { get; }
+        public ushort Pressed { get; }
+        public ushort Hover { get; }
+    }
+
+    /// <summary>The shard's buttons. Later pages (League, guild progress, loop status) are one line each.</summary>
+    public static readonly Entry[] All =
+    {
+        new("achievements", "Achievements", 22456, 22457, 22458),
+    };
+
+    /// <summary>The entry that takes the paperdoll's Help slot (the first with paperdoll art), or null.</summary>
+    public static Entry Paperdoll => Array.Find(All, e => e.Normal != 0);
+
+    private static bool _offered, _hooked;
+
+    /// <summary>True on a connection whose server asked for id 4 (our shard); false before, after and elsewhere.</summary>
+    public static bool Available => _offered;
+
+    /// <summary>Called with cc-P103's acknowledgement: this connection's server asked for id 4.</summary>
+    internal static void MarkOffered(AsyncNetClient socket)
+    {
+        _offered = true;
+        if (!_hooked && socket != null)
+        {
+            _hooked = true;
+            socket.Disconnected += (_, _) => _offered = false;
+        }
+    }
+
+    internal static void Reset() => _offered = false;
+
+    public static bool IsKnown(string command) => Array.Exists(All, e => string.Equals(e.Command, command, StringComparison.Ordinal));
+
+    /// <summary>The packet for one entry's command: [0xCE][u16 length][u16 4][ASCII command, 0]. Null for anything that is
+    /// not in the table.</summary>
+    public static byte[] Build(string command)
+    {
+        if (command == null || !IsKnown(command))
+            return null;
+
+        StackDataWriter f = Extensions.GetWriter(EnhancedPacketType.ClientCommand);
+        ref StackDataWriter writer = ref f;
+        writer.WriteASCII(command); // with its terminating 0
+        writer.FinalLength();
+        byte[] bytes = writer.BufferWritten.ToArray();
+        writer.Dispose();
+        return bytes;
+    }
+
+    /// <summary>Asks the server for the page, if this connection offers shard buttons. Returns whether it was sent.</summary>
+    public static bool Send(string command)
+    {
+        if (!Available)
+            return false;
+
+        byte[] bytes = Build(command);
+        if (bytes == null || AsyncNetClient.Socket == null)
+            return false;
+
+        AsyncNetClient.Socket.Send(bytes, true);
+        return true;
+    }
+}
diff --git a/tests/ClassicUO.UnitTests/Network/ShardButtonsTests.cs b/tests/ClassicUO.UnitTests/Network/ShardButtonsTests.cs
new file mode 100644
index 000000000..3f154d770
--- /dev/null
+++ b/tests/ClassicUO.UnitTests/Network/ShardButtonsTests.cs
@@ -0,0 +1,61 @@
+// Shattered Legacy patch (cc-P147): the shard buttons (Achievements first).
+using System.Linq;
+using System.Text;
+using ClassicUO.Network;
+using FluentAssertions;
+using Xunit;
+
+namespace ClassicUO.UnitTests.Network
+{
+    public class ShardButtonsTests
+    {
+        [Fact]
+        public void The_table_holds_achievements_with_its_label_and_paperdoll_gumps()
+        {
+            ShardButtons.All.Select(e => e.Command).Should().Equal("achievements");
+            ShardButtons.All[0].Label.Should().Be("Achievements");
+            new[] { ShardButtons.All[0].Normal, ShardButtons.All[0].Pressed, ShardButtons.All[0].Hover }
+                .Should().Equal((ushort)22456, (ushort)22457, (ushort)22458);
+            ShardButtons.Paperdoll.Should().BeSameAs(ShardButtons.All[0]);
+        }
+
+        [Fact]
+        public void The_request_is_enhanced_packet_4_with_the_command()
+        {
+            byte[] expected = new byte[] { 0xCE, 0x00, 0x12, 0x00, 0x04 }
+                .Concat(Encoding.ASCII.GetBytes("achievements")).Concat(new byte[] { 0 }).ToArray();
+            ShardButtons.Build("achievements").Should().Equal(expected);
+        }
+
+        [Theory]
+        [InlineData("worldmap")]
+        [InlineData("Achievements")]
+        [InlineData("achievements ")]
+        [InlineData("cast Fireball")]
+        [InlineData("")]
+        [InlineData(null)]
+        public void Nothing_off_the_table_is_ever_built(string command)
+        {
+            ShardButtons.Build(command).Should().BeNull();
+        }
+
+        [Fact]
+        public void The_buttons_follow_the_connections_answer()
+        {
+            ShardButtons.Reset();
+            ShardButtons.Available.Should().BeFalse("a server that never asked for id 4 shows no shard buttons");
+            ShardButtons.Send("achievements").Should().BeFalse("nothing is sent before the server asked");
+            ShardButtons.MarkOffered(null);
+            ShardButtons.Available.Should().BeTrue();
+            ShardButtons.Reset();
+            ShardButtons.Available.Should().BeFalse("the next handshake starts again");
+        }
+
+        [Fact]
+        public void The_shard_buttons_are_not_commands_the_server_can_run_here()
+        {
+            foreach (ShardButtons.Entry e in ShardButtons.All)
+                EnhancedClientCommand.TryParse(e.Command, out _).Should().BeFalse(e.Command + " goes to the server, not the reverse");
+        }
+    }
+}
