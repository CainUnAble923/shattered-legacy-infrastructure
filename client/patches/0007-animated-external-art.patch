+// Shattered Legacy patch (cc-P374): animated statics whose art comes only from ExternalImages still change frame.
+using System;
+using System.IO;
+using ClassicUO.IO;
+using FluentAssertions;
+using Xunit;
+
+namespace ClassicUO.UnitTests.IO
+{
+    public class AnimOffsetTests : IDisposable
+    {
+        private const int ArtStaticOffset = 0x4000;
+        private const int Vat = 0x6D70; // the guild hall decor's bubbling vat: a PNG in ExternalImagesrt, no art.mul entry
+        private const int Fire = 0x19AB; // a stock animated static with art in the client files
+
+        private readonly string _path = Path.GetTempFileName();
+        private readonly UOFile _file;
+
+        public AnimOffsetTests()
+        {
+            File.WriteAllBytes(_path, new byte[64]);
+            _file = new UOFile(_path);
+            _file.Entries = new UOFileIndex[ArtStaticOffset + 0x10000];
+            _file.Entries[ArtStaticOffset + Fire] = new UOFileIndex(_file, 16, 16, 16);
+        }
+
+        public void Dispose()
+        {
+            _file.Dispose();
+            File.Delete(_path);
+        }
+
+        [Fact]
+        public void AnArtIdWithNoFileEntryStillReportsItsAnimationFrame()
+        {
+            _file.Entries[ArtStaticOffset + Vat].AnimOffset = 2; // as AnimatedStaticsManager.Process sets it
+
+            _file.GetAnimOffset(ArtStaticOffset + Vat).Should().Be(2);
+            _file.GetValidRefEntry(ArtStaticOffset + Vat).AnimOffset.Should().Be(0, "the empty entry reads as Invalid, the bug this patch routes around");
+        }
+
+        [Fact]
+        public void AStockArtIdReportsItsAnimationFrameAsBefore()
+        {
+            _file.Entries[ArtStaticOffset + Fire].AnimOffset = 5;
+
+            _file.GetAnimOffset(ArtStaticOffset + Fire).Should().Be(5);
+            _file.GetValidRefEntry(ArtStaticOffset + Fire).AnimOffset.Should().Be(5);
+        }
+
+        [Fact]
+        public void AnIndexOutsideTheTableHasNoOffset()
+        {
+            _file.GetAnimOffset(-1).Should().Be(0);
+            _file.GetAnimOffset(_file.Entries.Length).Should().Be(0);
+        }
+    }
+}
