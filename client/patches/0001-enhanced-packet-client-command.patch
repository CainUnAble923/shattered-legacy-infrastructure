diff --git a/src/ClassicUO.Client/Network/EnhancedPackets/EnhancedClientCommand.cs b/src/ClassicUO.Client/Network/EnhancedPackets/EnhancedClientCommand.cs
new file mode 100644
index 000000000..f1e822814
--- /dev/null
+++ b/src/ClassicUO.Client/Network/EnhancedPackets/EnhancedClientCommand.cs
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: BSD-2-Clause
+// Shattered Legacy patch (cc-P103): enhanced packet 4, ClientCommand. A server runs one whitelisted client command for
+// the player, so a tutorial button can open the World Map, the Journal or the options window.
+//
+// Server -> client: HEADER (ushort id 4, ushort version 0), then the command line as null-terminated ASCII, without
+// the leading "-" (for example "worldmap" or "radius 5"). It runs only if its first word is on the whitelist, through
+// CommandManager.Execute, and only behind the enhanced-packet opt-in (EnhancedPacketHandler.Enabled). Anything else is
+// ignored and logged once per command name.
+//
+// Client -> server: when the server's EnableEnhancedPacket lists id 4, the client answers HEADER with id 4, so the
+// server knows this client can run commands. A client without this patch never answers id 4.
+
+using System;
+using System.Collections.Generic;
+using ClassicUO.Game;
+using ClassicUO.IO;
+using ClassicUO.Utility.Logging;
+
+namespace ClassicUO.Network;
+
+public static class EnhancedClientCommand
+{
+    public const int MaxLength = 100;
+
+    public static readonly string[] Whitelist = { "optlink", "paperdoll", "marktile", "radius", "worldmap", "journal", "options" };
+
+    private static readonly HashSet<string> _logged = new(StringComparer.OrdinalIgnoreCase);
+
+    /// <summary>The command split on spaces, if its first word is on the whitelist and it is plain printable ASCII.</summary>
+    public static bool TryParse(string line, out string[] parts)
+    {
+        parts = Array.Empty<string>();
+        if (string.IsNullOrWhiteSpace(line) || line.Length > MaxLength)
+            return false;
+
+        foreach (char c in line)
+        {
+            if (c < 0x20 || c > 0x7E)
+                return false;
+        }
+
+        string[] split = line.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
+        if (split.Length == 0 || Array.IndexOf(Whitelist, split[0].ToLowerInvariant()) < 0)
+            return false;
+
+        parts = split;
+        return true;
+    }
+
+    /// <summary>True the first time a refused command name is seen, so each is logged once.</summary>
+    public static bool ShouldLogRefusal(string line)
+    {
+        string head = (line ?? "").Trim().Split(' ', 2)[0];
+        return _logged.Add(head.Length > 32 ? head.Substring(0, 32) : head);
+    }
+
+    internal static void Handle(ref StackDataReader p, int version)
+    {
+        string line = p.ReadASCII();
+
+        if (!TryParse(line, out string[] parts))
+        {
+            if (ShouldLogRefusal(line))
+                Log.Warn($"Server ClientCommand ignored, not on the whitelist: '{line}'");
+            return;
+        }
+
+        World world = Client.Game?.UO?.World;
+        if (world?.Player == null)
+            return;
+
+        world.CommandManager.Execute(parts[0], parts);
+    }
+
+    /// <summary>Tells the server this client runs ClientCommand, if the server asked for it.</summary>
+    public static void SendAck(this AsyncNetClient socket)
+    {
+        if (!EnhancedOutgoingPackets.EnabledPackets.Contains(EnhancedPacketType.ClientCommand))
+            return;
+
+        StackDataWriter f = Extensions.GetWriter(EnhancedPacketType.ClientCommand);
+        ref StackDataWriter writer = ref f;
+        writer.FinalLength();
+        socket.Send(writer.BufferWritten, true);
+        writer.Dispose();
+    }
+}
diff --git a/src/ClassicUO.Client/Network/EnhancedPackets/EnhancedPacketHandler.cs b/src/ClassicUO.Client/Network/EnhancedPackets/EnhancedPacketHandler.cs
index 2d9a85e58..0c237a601 100644
--- a/src/ClassicUO.Client/Network/EnhancedPackets/EnhancedPacketHandler.cs
+++ b/src/ClassicUO.Client/Network/EnhancedPackets/EnhancedPacketHandler.cs
@@ -22,6 +22,7 @@ public class EnhancedPacketHandler
         
         Handler.Add(EnhancedPacketType.EnableEnhancedPacket, EnableEnhancedPacket);
         Handler.Add(EnhancedPacketType.DisableFeatures, DisableFeatures);
+        Handler.Add(EnhancedPacketType.ClientCommand, EnhancedClientCommand.Handle);
     }
 
     /// <summary>
@@ -47,6 +48,7 @@ public class EnhancedPacketHandler
         }
         
         AsyncNetClient.Socket.SendEnhancedPacket(); //Confirm we are ready to receive enhanced packets.
+        AsyncNetClient.Socket.SendAck(); //Shattered Legacy patch (cc-P103): say we run ClientCommand, if asked.
     }
 
     /// <summary>
diff --git a/src/ClassicUO.Client/Network/EnhancedPackets/EnhancedPacketTypeEnum.cs b/src/ClassicUO.Client/Network/EnhancedPackets/EnhancedPacketTypeEnum.cs
