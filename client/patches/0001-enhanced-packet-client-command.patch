@@ -5,5 +5,6 @@ public enum EnhancedPacketType : ushort
     None,
     EnableEnhancedPacket,
     TazUO_Identifier,
-    DisableFeatures
+    DisableFeatures,
+    ClientCommand = 4 // Shattered Legacy patch (cc-P103): EnhancedClientCommand.cs
 }
diff --git a/tests/ClassicUO.UnitTests/Network/EnhancedClientCommandTests.cs b/tests/ClassicUO.UnitTests/Network/EnhancedClientCommandTests.cs
new file mode 100644
index 000000000..df3196f20
--- /dev/null
+++ b/tests/ClassicUO.UnitTests/Network/EnhancedClientCommandTests.cs
@@ -0,0 +1,68 @@
+// Shattered Legacy patch (cc-P103): the ClientCommand whitelist.
+using ClassicUO.Network;
+using FluentAssertions;
+using Xunit;
+
+namespace ClassicUO.UnitTests.Network
+{
+    public class EnhancedClientCommandTests
+    {
+        [Theory]
+        [InlineData("worldmap", new[] { "worldmap" })]
+        [InlineData("journal", new[] { "journal" })]
+        [InlineData("options", new[] { "options" })]
+        [InlineData("optlink", new[] { "optlink" })]
+        [InlineData("paperdoll", new[] { "paperdoll" })]
+        [InlineData("marktile -r", new[] { "marktile", "-r" })]
+        [InlineData("  radius 5 33 ", new[] { "radius", "5", "33" })]
+        [InlineData("WorldMap", new[] { "WorldMap" })]
+        public void Whitelisted_commands_parse(string line, string[] expected)
+        {
+            EnhancedClientCommand.TryParse(line, out string[] parts).Should().BeTrue();
+            parts.Should().Equal(expected);
+        }
+
+        [Theory]
+        [InlineData("cast Fireball")]
+        [InlineData("organizer")]
+        [InlineData("playlscript evil.py")]
+        [InlineData("sb")]
+        [InlineData("")]
+        [InlineData("   ")]
+        [InlineData("-worldmap")]
+        [InlineData("journal\n-cast Kill")]
+        [InlineData("worldmapé")]
+        public void Anything_else_is_refused(string line)
+        {
+            EnhancedClientCommand.TryParse(line, out string[] parts).Should().BeFalse();
+            parts.Should().BeEmpty();
+        }
+
+        [Fact]
+        public void Too_long_is_refused()
+        {
+            EnhancedClientCommand.TryParse("radius " + new string('5', 100), out _).Should().BeFalse();
+        }
+
+        [Fact]
+        public void The_whitelist_is_the_seven()
+        {
+            EnhancedClientCommand.Whitelist.Should().Equal("optlink", "paperdoll", "marktile", "radius", "worldmap", "journal", "options");
+        }
+
+        [Fact]
+        public void A_refusal_is_logged_once_per_name()
+        {
+            EnhancedClientCommand.ShouldLogRefusal("p103test-unknown a").Should().BeTrue();
+            EnhancedClientCommand.ShouldLogRefusal("p103test-unknown b").Should().BeFalse();
+            EnhancedClientCommand.ShouldLogRefusal("P103TEST-UNKNOWN").Should().BeFalse();
+            EnhancedClientCommand.ShouldLogRefusal("p103test-other").Should().BeTrue();
+        }
+
+        [Fact]
+        public void ClientCommand_is_enhanced_packet_4()
+        {
+            ((ushort)EnhancedPacketType.ClientCommand).Should().Be(4);
+        }
+    }
+}
