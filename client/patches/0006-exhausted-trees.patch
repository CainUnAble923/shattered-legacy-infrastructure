diff --git a/tests/ClassicUO.UnitTests/Game/ShardExhaustedTreesTests.cs b/tests/ClassicUO.UnitTests/Game/ShardExhaustedTreesTests.cs
new file mode 100644
index 000000000..875c39a90
--- /dev/null
+++ b/tests/ClassicUO.UnitTests/Game/ShardExhaustedTreesTests.cs
@@ -0,0 +1,143 @@
+// Shattered Legacy patch (cc-P412): exhausted trees, fed by the shard's packet 0xF4 sub 0x05, hidden until they regrow.
+using System;
+using System.Collections.Generic;
+using ClassicUO.Game.Managers;
+using ClassicUO.IO;
+using FluentAssertions;
+using Xunit;
+
+namespace ClassicUO.UnitTests.Game
+{
+    public class ShardExhaustedTreesTests : IDisposable
+    {
+        private long _now = 1_000_000;
+
+        public ShardExhaustedTreesTests()
+        {
+            ShardExhaustedTrees.Reset();
+            ShardExhaustedTrees.Clock = () => _now;
+        }
+
+        public void Dispose()
+        {
+            ShardExhaustedTrees.Reset();
+            ShardExhaustedTrees.Clock = ShardExhaustedTrees.DefaultClock;
+        }
+
+        // The server's ClusterFExhaustedTrees.BuildPacket payload: per tree [u16 x][u16 y][u32 seconds][u8 n][n x u16 id].
+        private static byte[] Payload(params (int x, int y, uint seconds, ushort[] ids)[] trees)
+        {
+            var b = new List<byte>();
+            foreach (var (x, y, seconds, ids) in trees)
+            {
+                b.Add((byte)(x >> 8));
+                b.Add((byte)x);
+                b.Add((byte)(y >> 8));
+                b.Add((byte)y);
+                b.Add((byte)(seconds >> 24));
+                b.Add((byte)(seconds >> 16));
+                b.Add((byte)(seconds >> 8));
+                b.Add((byte)seconds);
+                b.Add((byte)ids.Length);
+                foreach (ushort id in ids)
+                {
+                    b.Add((byte)(id >> 8));
+                    b.Add((byte)id);
+                }
+            }
+
+            return b.ToArray();
+        }
+
+        private static byte[] Packet(byte facet, byte[] payload)
+        {
+            int total = 9 + payload.Length;
+            var b = new byte[total];
+            b[0] = 0xF4;
+            b[1] = (byte)(total >> 8);
+            b[2] = (byte)total;
+            b[3] = ShardExhaustedTrees.Sub;
+            b[4] = facet;
+            b[5] = (byte)(payload.Length >> 24);
+            b[6] = (byte)(payload.Length >> 16);
+            b[7] = (byte)(payload.Length >> 8);
+            b[8] = (byte)payload.Length;
+            payload.CopyTo(b, 9);
+            return b;
+        }
+
+        private static readonly ushort[] Tree = { 0x0CCD, 0x0CCE };
+
+        [Fact]
+        public void The_servers_packet_reaches_the_list_through_the_0xF4_handler()
+        {
+            byte[] packet = Packet(1, Payload((1252, 1240, 600, Tree)));
+            var reader = new StackDataReader(packet);
+            reader.Seek(3);
+            ShardFogOfWar.Receive(null, ref reader);
+
+            ShardExhaustedTrees.IsHidden(1, 1252, 1240, 0x0CCD).Should().BeTrue("the trunk");
+            ShardExhaustedTrees.IsHidden(1, 1252, 1240, 0x0CCE).Should().BeTrue("its leaves");
+            ShardFogOfWar.HasData(1).Should().BeFalse("a tree is not a walked chunk");
+        }
+
+        [Fact]
+        public void Only_those_item_ids_at_that_tile_on_that_facet_are_hidden()
+        {
+            ShardExhaustedTrees.Apply(1, Payload((1252, 1240, 600, Tree))).Should().BeTrue();
+
+            ShardExhaustedTrees.IsHidden(1, 1252, 1240, 0x0E56).Should().BeFalse("the stump stays");
+            ShardExhaustedTrees.IsHidden(1, 1252, 1240, 0x0080).Should().BeFalse("anything else on the tile stays");
+            ShardExhaustedTrees.IsHidden(1, 1253, 1240, 0x0CCD).Should().BeFalse("the same tree art next door stays");
+            ShardExhaustedTrees.IsHidden(0, 1252, 1240, 0x0CCD).Should().BeFalse("the same spot on Felucca stays");
+        }
+
+        [Fact]
+        public void A_tree_shows_again_at_its_deadline_even_with_no_word_from_the_server()
+        {
+            ShardExhaustedTrees.Apply(1, Payload((1252, 1240, 600, Tree)));
+            _now += 599_000;
+            ShardExhaustedTrees.IsHidden(1, 1252, 1240, 0x0CCD).Should().BeTrue();
+            _now += 1_000;
+            ShardExhaustedTrees.IsHidden(1, 1252, 1240, 0x0CCD).Should().BeFalse("its bank refilled while we were away");
+            ShardExhaustedTrees.Count.Should().Be(0);
+        }
+
+        [Fact]
+        public void Regrowth_from_the_server_shows_it_at_once()
+        {
+            ShardExhaustedTrees.Apply(1, Payload((1252, 1240, 600, Tree)));
+            ShardExhaustedTrees.Apply(1, Payload((1252, 1240, 0, Tree))).Should().BeTrue();
+            ShardExhaustedTrees.IsHidden(1, 1252, 1240, 0x0CCD).Should().BeFalse();
+            ShardExhaustedTrees.Count.Should().Be(0);
+        }
+
+        [Fact]
+        public void A_login_list_holds_several_trees_and_a_new_login_starts_empty()
+        {
+            ShardExhaustedTrees.Apply(3, Payload((10, 20, 60, Tree), (11, 20, 30, new ushort[] { 0x0D41 }))).Should().BeTrue();
+            ShardExhaustedTrees.Count.Should().Be(2);
+            ShardExhaustedTrees.IsHidden(3, 11, 20, 0x0D41).Should().BeTrue();
+            ShardExhaustedTrees.Reset();
+            ShardExhaustedTrees.IsHidden(3, 10, 20, 0x0CCD).Should().BeFalse();
+        }
+
+        [Fact]
+        public void A_tree_out_of_view_is_still_hidden_when_we_come_back()
+        {
+            // The list is not tied to the view: nothing about range or the map's loaded blocks touches it.
+            ShardExhaustedTrees.Apply(1, Payload((1252, 1240, 600, Tree)));
+            _now += 120_000;
+            ShardExhaustedTrees.IsHidden(1, 1252, 1240, 0x0CCD).Should().BeTrue();
+        }
+
+        [Fact]
+        public void A_cut_short_or_empty_message_changes_nothing()
+        {
+            byte[] good = Payload((1252, 1240, 600, Tree));
+            ShardExhaustedTrees.Apply(1, good.AsSpan(0, good.Length - 1)).Should().BeFalse();
+            ShardExhaustedTrees.Apply(1, ReadOnlySpan<byte>.Empty).Should().BeFalse();
+            ShardExhaustedTrees.Count.Should().Be(0);
+        }
+    }
+}
