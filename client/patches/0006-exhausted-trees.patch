diff --git a/src/ClassicUO.Client/Game/Managers/ShardExhaustedTrees.cs b/src/ClassicUO.Client/Game/Managers/ShardExhaustedTrees.cs
new file mode 100644
index 000000000..2e05a4414
--- /dev/null
+++ b/src/ClassicUO.Client/Game/Managers/ShardExhaustedTrees.cs
@@ -0,0 +1,100 @@
+// Shattered Legacy patch (cc-P412): trees the shard says are chopped empty are hidden until they regrow.
+//
+// The shard puts a stump item at a chopped-out tree (server\customizations\ClusterFLumberStumps.cs) and tells clients
+// which tree statics to hide, on its own packet 0xF4 (ShardFogOfWar's) as sub 0x05:
+//   [0xF4][u16 length][u8 0x05][u8 facet][u32 BE payload length] then per tree:
+//   [u16 x][u16 y][u32 seconds until it regrows, 0 = it regrew now][u8 n][n x u16 item ID]
+// Only those item IDs at that X,Y on that facet are hidden (the trunk and the foliage over it); the stump, which is an
+// item and not a static, and everything else on the map are untouched. A tree shows again at its deadline even if
+// the regrowth message never comes. The list is per facet and not tied to the view, so walking away and back changes
+// nothing. Each new login starts empty (EnterWorld), and the shard resends every exhausted tree at login.
+
+using System;
+using System.Collections.Generic;
+
+namespace ClassicUO.Game.Managers
+{
+    public static class ShardExhaustedTrees
+    {
+        public const byte Sub = 0x05;
+
+        private const int EntryHeader = 9; // x, y, seconds, n
+
+        private readonly struct Tree
+        {
+            public Tree(ushort[] ids, long deadline)
+            {
+                Ids = ids;
+                Deadline = deadline;
+            }
+
+            public ushort[] Ids { get; }
+            public long Deadline { get; }
+        }
+
+        private static readonly Dictionary<(int Facet, int X, int Y), Tree> _trees = new();
+
+        /// <summary>Milliseconds; a test replaces it.</summary>
+        public static readonly Func<long> DefaultClock = () => Environment.TickCount64;
+        public static Func<long> Clock { get; set; } = DefaultClock;
+
+        public static int Count => _trees.Count;
+
+        public static void Reset() => _trees.Clear();
+
+        /// <summary>One sub 0x05 payload. False, and nothing changed, when it is malformed.</summary>
+        public static bool Apply(byte facet, ReadOnlySpan<byte> payload)
+        {
+            if (payload.Length == 0)
+                return false;
+
+            // Check the whole message first, so a cut-short one changes nothing.
+            int o = 0;
+            while (o < payload.Length)
+            {
+                if (payload.Length - o < EntryHeader)
+                    return false;
+
+                o += EntryHeader + 2 * payload[o + 8];
+                if (o > payload.Length)
+                    return false;
+            }
+
+            long now = Clock();
+            for (o = 0; o < payload.Length; )
+            {
+                int x = (payload[o] << 8) | payload[o + 1];
+                int y = (payload[o + 2] << 8) | payload[o + 3];
+                uint seconds = (uint)((payload[o + 4] << 24) | (payload[o + 5] << 16) | (payload[o + 6] << 8) | payload[o + 7]);
+                int n = payload[o + 8];
+                var ids = new ushort[n];
+                for (int i = 0; i < n; i++)
+                    ids[i] = (ushort)((payload[o + EntryHeader + 2 * i] << 8) | payload[o + EntryHeader + 2 * i + 1]);
+
+                o += EntryHeader + 2 * n;
+
+                if (seconds == 0 || n == 0)
+                    _trees.Remove((facet, x, y));
+                else
+                    _trees[(facet, x, y)] = new Tree(ids, now + seconds * 1000L);
+            }
+
+            return true;
+        }
+
+        /// <summary>Whether the map static with this original graphic at this tile is an exhausted tree's.</summary>
+        public static bool IsHidden(int facet, int x, int y, ushort graphic)
+        {
+            if (_trees.Count == 0 || !_trees.TryGetValue((facet, x, y), out var tree))
+                return false;
+
+            if (Clock() >= tree.Deadline)
+            {
+                _trees.Remove((facet, x, y));
+                return false;
+            }
+
+            return Array.IndexOf(tree.Ids, graphic) >= 0;
+        }
+    }
+}
