diff --git a/tests/ClassicUO.UnitTests/Game/SlSkinsTests.cs b/tests/ClassicUO.UnitTests/Game/SlSkinsTests.cs
new file mode 100644
index 000000000..e14534935
--- /dev/null
+++ b/tests/ClassicUO.UnitTests/Game/SlSkinsTests.cs
@@ -0,0 +1,149 @@
+// Shattered Legacy patch (cc-P362): the UI skins (Game\Managers\SlSkins.cs, the remap in ExternalImageLoader, the
+// Appearance tab). The image folders here hold empty stand-in files named like the IDs: the remap only needs to know a
+// file is there, and no art is ever needed (or allowed) in a test.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using ClassicUO.Assets;
+using ClassicUO.Game.Managers;
+using ClassicUO.Game.UI.MyraWindows.Options.Tabs;
+using FluentAssertions;
+using Xunit;
+
+namespace ClassicUO.UnitTests.Game
+{
+    public class SlSkinsTests : IDisposable
+    {
+        private readonly string _root = Path.Combine(Path.GetTempPath(), "sl-skins-" + Guid.NewGuid().ToString("N"));
+
+        public void Dispose()
+        {
+            if (Directory.Exists(_root))
+                Directory.Delete(_root, true);
+        }
+
+        private static bool Everything(uint id) => true;
+        private static bool Nothing(uint id) => false;
+
+        private string Images(uint[] gumps, uint[] art)
+        {
+            Directory.CreateDirectory(Path.Combine(_root, "gumps"));
+            Directory.CreateDirectory(Path.Combine(_root, "art"));
+            foreach (uint g in gumps)
+                File.WriteAllBytes(Path.Combine(_root, "gumps", g + ".png"), Array.Empty<byte>());
+            foreach (uint a in art)
+                File.WriteAllBytes(Path.Combine(_root, "art", a + ".png"), Array.Empty<byte>());
+            return _root;
+        }
+
+        [Fact]
+        public void No_skin_draws_over_a_stock_ID_and_every_skin_uses_the_registered_ranges()
+        {
+            var stock = SlSkins.All.SelectMany(s => s.Map.Keys).ToHashSet();
+            foreach (SlSkins.Skin s in SlSkins.All)
+            {
+                s.Map.Values.Should().NotIntersectWith(stock, $"{s.Kind}/{s.Key} would draw one stock ID as another");
+                bool art = SlSkins.IsArtKind(s.Kind);
+                foreach (uint id in s.Map.Values)
+                    (art ? id >= 13049 && id <= 13112 : id >= 23052 && id <= 23080).Should().BeTrue($"{s.Kind}/{s.Key} {id} is registered");
+            }
+
+            SlSkins.All.Select(s => s.Kind + "/" + s.Key).Should().OnlyHaveUniqueItems();
+            SlSkins.Kinds.Select(k => k.Key).Should().Equal("backpack", "bag", "chest", "crate", "scroll");
+            foreach ((string kind, _, _) in SlSkins.Kinds)
+                SlSkins.OfKind(kind).Should().NotBeEmpty();
+            SlSkins.All.Should().HaveCount(19);
+            SlSkins.All.Single(s => s.Kind == "scroll").Map.Keys.Should().BeEquivalentTo(Enumerable.Range(0x1F2D, 64).Select(i => (uint)i));
+        }
+
+        [Fact]
+        public void The_choices_round_trip_and_Classic_is_the_default()
+        {
+            SlSkins.Parse(null).Should().BeEmpty();
+            SlSkins.Parse("").Should().BeEmpty();
+            var c = SlSkins.Parse("scroll=magic-scrolls; backpack=fancy;junk;=x;bag=");
+            c.Should().HaveCount(2);
+            c["backpack"].Should().Be("fancy");
+            SlSkins.Format(c).Should().Be("backpack=fancy;scroll=magic-scrolls");
+            c["backpack"] = SlSkins.Classic;
+            SlSkins.Format(c).Should().Be("scroll=magic-scrolls", "Classic is not saved: it is the default");
+            new ClassicUO.Configuration.Profile().SlSkins.Should().BeEmpty("a profile from before the option is all Classic");
+        }
+
+        [Fact]
+        public void A_skin_is_offered_only_when_all_its_files_are_here_and_falls_back_to_Classic_otherwise()
+        {
+            SlSkins.Available("backpack", Nothing, Nothing).Should().BeEmpty();
+            SlSkins.Available("backpack", Everything, Nothing).Should().HaveCount(8);
+            SlSkins.Available("scroll", Everything, Nothing).Should().BeEmpty("the scroll skin is art, not gumps");
+
+            var only = new HashSet<uint> { 23060, 23061 }; // Bloody's two gumps
+            SlSkins.Available("backpack", only.Contains, Nothing).Select(s => s.Key).Should().Equal("bloody");
+
+            var choices = SlSkins.Parse("backpack=fancy");
+            SlSkins.Effective("backpack", choices, only.Contains, Nothing).Should().BeNull("Fancy's files are missing: Classic");
+            SlSkins.Remaps(choices, only.Contains, Nothing).Gumps.Should().BeEmpty();
+        }
+
+        [Fact]
+        public void The_remaps_are_the_picked_skins_gumps_by_ID_and_art_by_art_index()
+        {
+            var choices = SlSkins.Parse("backpack=fancy;chest=teal;scroll=magic-scrolls");
+            (Dictionary<uint, uint> gumps, Dictionary<uint, uint> art) = SlSkins.Remaps(choices, Everything, Everything);
+            gumps.Should().BeEquivalentTo(new Dictionary<uint, uint> { [0x3C] = 23052, [0x50] = 23053, [0xC4F6] = 23054, [0x4A] = 23077 });
+            art.Should().HaveCount(64);
+            art[0x1F2D + 0x4000u].Should().Be(13049 + 0x4000u, "Reactive Armor, the first scroll");
+            art[0x1F6C + 0x4000u].Should().Be(13112 + 0x4000u, "Summon Water Elemental, the last");
+
+            var bloody = SlSkins.Remaps(SlSkins.Parse("backpack=bloody"), Everything, Everything).Gumps;
+            bloody.Keys.Should().BeEquivalentTo(new uint[] { 0x3C, 0xC4F6 }, "Bloody has no minimized icon: stock's stays");
+        }
+
+        [Fact]
+        public void The_loader_draws_a_stock_ID_from_the_skins_file_only_while_remapped()
+        {
+            var loader = new ExternalImageLoader();
+            string root = Images(new uint[] { 60, 23052, 12 }, new uint[] { 0x1F2D, 13049 });
+            loader.ScanImages(root);
+            string own60 = Path.Combine(root, "gumps", "60.png");
+            string skin = Path.Combine(root, "gumps", "23052.png");
+
+            loader.ResolveGumpPath(60).Should().Be(own60);
+            loader.ResolveGumpPath(61).Should().BeNull("no PNG: the client's own gump");
+
+            loader.SetGumpRemap(new Dictionary<uint, uint> { [60] = 23052, [61] = 99999 }).Should().BeEquivalentTo(new uint[] { 60, 61 });
+            loader.ResolveGumpPath(60).Should().Be(skin);
+            loader.ResolveGumpPath(61).Should().BeNull("a remap to a file that is not here draws stock");
+            loader.ResolveGumpPath(23052).Should().Be(skin, "the skin's own ID is untouched");
+
+            loader.SetGumpOverrides(new Dictionary<uint, string> { [60] = "body" });
+            loader.ResolveGumpPath(60).Should().Be("body", "cc-P111's override still comes first");
+            loader.SetGumpOverrides(null);
+
+            loader.SetGumpRemap(new Dictionary<uint, uint> { [60] = 23052, [61] = 99999 }).Should().BeEmpty("nothing changed");
+            loader.SetGumpRemap(null).Should().BeEquivalentTo(new uint[] { 60, 61 });
+            loader.ResolveGumpPath(60).Should().Be(own60, "back to Classic");
+
+            uint stockArt = 0x1F2D + 0x4000u, skinArt = 13049 + 0x4000u;
+            loader.ResolveArtPath(stockArt).Should().Be(Path.Combine(root, "art", 0x1F2D + ".png"));
+            loader.SetArtRemap(new Dictionary<uint, uint> { [stockArt] = skinArt }).Should().Equal(stockArt);
+            loader.ResolveArtPath(stockArt).Should().Be(Path.Combine(root, "art", "13049.png"));
+            loader.GetArtFilePath(skinArt).Should().NotBeNull();
+            loader.GetGumpFilePath(23052).Should().Be(skin);
+        }
+
+        [Fact]
+        public void The_Appearance_page_lists_Classic_first_and_previews_the_main_piece()
+        {
+            var fancy = SlSkins.All.First(s => s.Kind == "backpack" && s.Key == "fancy");
+            var scrolls = SlSkins.All.Single(s => s.Kind == "scroll");
+            var teal = SlSkins.All.First(s => s.Kind == "chest" && s.Key == "teal");
+            AppearanceTab.Labels(new[] { fancy }).Should().Equal("Classic (stock)", "Fancy (Carl Hamilton)");
+            AppearanceTab.Labels(Array.Empty<SlSkins.Skin>()).Should().Equal("Classic (stock)");
+            AppearanceTab.PreviewId(fancy).Should().Be(23052u, "the open backpack");
+            AppearanceTab.PreviewId(scrolls).Should().Be(13099u, "Flamestrike (0x1F5F)");
+            AppearanceTab.PreviewId(teal).Should().Be(23077u);
+        }
+    }
+}
