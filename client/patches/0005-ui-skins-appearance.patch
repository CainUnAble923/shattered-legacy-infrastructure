diff --git a/src/ClassicUO.Client/Game/Managers/SlSkins.cs b/src/ClassicUO.Client/Game/Managers/SlSkins.cs
new file mode 100644
index 000000000..6cd50916d
--- /dev/null
+++ b/src/ClassicUO.Client/Game/Managers/SlSkins.cs
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: BSD-2-Clause
+// Shattered Legacy patch (cc-P362): optional UI skins, picked per profile in Options > Interface > Appearance.
+//
+// Each skin draws a stock gump (or a stock item's art) from one of the shard's own PNGs instead, under a NEW ID that
+// the player package ships in ExternalImages (registry.csv, cc-P362). The stock ID keeps its stock art for everyone
+// who has not picked the skin; nothing is overwritten. The remap is client side only: no packet, no server flag, and
+// other players see nothing different. "Classic" (stock) is every kind's default.
+//
+// The table is written by shard-migration notes/cc-P362-tools/skins.py from the same data as the package's
+// vendor/shattered-legacy-art/skins.json (a package test keeps the two the same). A skin is offered only when every
+// file it needs is present, so a client without our art offers Classic alone.
+//
+// Later (cc-P362 notes, not built): a skin can carry a lock that a server flag lifts (a loot box or League shop
+// cosmetic). Available() is the one place such a check would go.
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using ClassicUO.Assets;
+using ClassicUO.Configuration;
+
+namespace ClassicUO.Game.Managers
+{
+    internal static class SlSkins
+    {
+        public const string Classic = "classic";
+
+        /// <summary>One skin: its kind, a key saved in the profile, the label, its author, and stock ID to our ID.
+        /// For the scroll kind the IDs are item art IDs (without the 0x4000 art offset); for the others, gump IDs.</summary>
+        public sealed record Skin(string Kind, string Key, string Label, string Author, Dictionary<uint, uint> Map);
+
+        /// <summary>The kinds, in page order: key, label, and whether its IDs are item art (true) or gumps.</summary>
+        public static readonly (string Key, string Label, bool Art)[] Kinds =
+        {
+            ("backpack", "Backpack", false),
+            ("bag", "Bags", false),
+            ("chest", "Metal chests and the bank box", false),
+            ("crate", "Crates", false),
+            ("scroll", "Spell scrolls", true)
+        };
+
+        public static readonly Skin[] All =
+        {
+            new("backpack", "fancy", "Fancy", "Carl Hamilton", new Dictionary<uint, uint> { [60] = 23052, [80] = 23053, [50422] = 23054 }),
+            new("backpack", "fancy-compact", "Fancy, compact", "Carl Hamilton", new Dictionary<uint, uint> { [60] = 23055, [80] = 23053, [50422] = 23054 }),
+            new("backpack", "gothic", "Gothic", "Carl Hamilton", new Dictionary<uint, uint> { [60] = 23056, [80] = 23057, [50422] = 23058 }),
+            new("backpack", "gothic-compact", "Gothic, compact", "Carl Hamilton", new Dictionary<uint, uint> { [60] = 23059, [80] = 23057, [50422] = 23058 }),
+            new("backpack", "bloody", "Bloody", "Safera", new Dictionary<uint, uint> { [60] = 23060, [50422] = 23061 }),
+            new("backpack", "celtic", "Celtic", "Safera", new Dictionary<uint, uint> { [60] = 23062, [80] = 23063, [50422] = 23064 }),
+            new("backpack", "dragon", "Dragon", "Safera", new Dictionary<uint, uint> { [60] = 23065, [80] = 23066, [50422] = 23067 }),
+            new("backpack", "leather", "Leather", "Safera", new Dictionary<uint, uint> { [60] = 23068, [80] = 23069, [50422] = 23070 }),
+            new("bag", "celtic", "Celtic", "Castiel", new Dictionary<uint, uint> { [61] = 23071 }),
+            new("bag", "primitive", "Primitive", "Castiel", new Dictionary<uint, uint> { [61] = 23072 }),
+            new("bag", "snowy", "Snowy", "Castiel", new Dictionary<uint, uint> { [61] = 23073 }),
+            new("chest", "blue", "Blue lining", "Erachiro", new Dictionary<uint, uint> { [74] = 23074 }),
+            new("chest", "pink", "Pink lining", "Erachiro", new Dictionary<uint, uint> { [74] = 23075 }),
+            new("chest", "red", "Red lining", "Erachiro", new Dictionary<uint, uint> { [74] = 23076 }),
+            new("chest", "teal", "Teal lining", "Erachiro", new Dictionary<uint, uint> { [74] = 23077 }),
+            new("chest", "yellow", "Yellow lining", "Erachiro", new Dictionary<uint, uint> { [74] = 23078 }),
+            new("crate", "refurbished", "Refurbished", "Erachiro", new Dictionary<uint, uint> { [68] = 23079 }),
+            new("crate", "weathered", "Weathered", "Erachiro", new Dictionary<uint, uint> { [68] = 23080 }),
+            new("scroll", "magic-scrolls", "Magic Scrolls", "CorvaeOboro", new Dictionary<uint, uint> { [7981] = 13049, [7982] = 13050, [7983] = 13051, [7984] = 13052, [7985] = 13053, [7986] = 13054, [7987] = 13055, [7988] = 13056, [7989] = 13057, [7990] = 13058, [7991] = 13059, [7992] = 13060, [7993] = 13061, [7994] = 13062, [7995] = 13063, [7996] = 13064, [7997] = 13065, [7998] = 13066, [7999] = 13067, [8000] = 13068, [8001] = 13069, [8002] = 13070, [8003] = 13071, [8004] = 13072, [8005] = 13073, [8006] = 13074, [8007] = 13075, [8008] = 13076, [8009] = 13077, [8010] = 13078, [8011] = 13079, [8012] = 13080, [8013] = 13081, [8014] = 13082, [8015] = 13083, [8016] = 13084, [8017] = 13085, [8018] = 13086, [8019] = 13087, [8020] = 13088, [8021] = 13089, [8022] = 13090, [8023] = 13091, [8024] = 13092, [8025] = 13093, [8026] = 13094, [8027] = 13095, [8028] = 13096, [8029] = 13097, [8030] = 13098, [8031] = 13099, [8032] = 13100, [8033] = 13101, [8034] = 13102, [8035] = 13103, [8036] = 13104, [8037] = 13105, [8038] = 13106, [8039] = 13107, [8040] = 13108, [8041] = 13109, [8042] = 13110, [8043] = 13111, [8044] = 13112 }),
+        };
+
+        public static bool IsArtKind(string kind) => Array.Exists(Kinds, k => k.Key == kind && k.Art);
+
+        public static IEnumerable<Skin> OfKind(string kind) => All.Where(s => s.Kind == kind);
+
+        /// <summary>The skins of a kind whose files are all present (Classic is always offered besides these).</summary>
+        public static List<Skin> Available(string kind, Func<uint, bool> hasGump, Func<uint, bool> hasArt)
+        {
+            bool art = IsArtKind(kind);
+            return OfKind(kind).Where(s => s.Map.Values.All(id => art ? hasArt(id) : hasGump(id))).ToList();
+        }
+
+        /// <summary>The profile's choices, "kind=key;kind=key". A kind not named is Classic.</summary>
+        public static Dictionary<string, string> Parse(string saved)
+        {
+            var choices = new Dictionary<string, string>();
+            if (string.IsNullOrWhiteSpace(saved))
+                return choices;
+            foreach (string part in saved.Split(';', StringSplitOptions.RemoveEmptyEntries))
+            {
+                string[] kv = part.Split('=', 2);
+                if (kv.Length == 2 && kv[0].Trim().Length > 0 && kv[1].Trim().Length > 0)
+                    choices[kv[0].Trim()] = kv[1].Trim();
+            }
+            return choices;
+        }
+
+        public static string Format(Dictionary<string, string> choices) =>
+            string.Join(";", choices.Where(c => c.Value != Classic).OrderBy(c => c.Key, StringComparer.Ordinal).Select(c => c.Key + "=" + c.Value));
+
+        /// <summary>The skin drawn for a kind: the chosen one if it is offered, else none (Classic).</summary>
+        public static Skin Effective(string kind, Dictionary<string, string> choices, Func<uint, bool> hasGump, Func<uint, bool> hasArt)
+        {
+            if (!choices.TryGetValue(kind, out string key) || key == Classic)
+                return null;
+            return Available(kind, hasGump, hasArt).FirstOrDefault(s => s.Key == key);
+        }
+
+        /// <summary>Every remap the choices make: gumps by gump ID, art by art index (item ID + 0x4000).</summary>
+        public static (Dictionary<uint, uint> Gumps, Dictionary<uint, uint> Art) Remaps(
+            Dictionary<string, string> choices, Func<uint, bool> hasGump, Func<uint, bool> hasArt)
+        {
+            var gumps = new Dictionary<uint, uint>();
+            var art = new Dictionary<uint, uint>();
+            foreach ((string kind, _, bool isArt) in Kinds)
+            {
+                Skin skin = Effective(kind, choices, hasGump, hasArt);
+                if (skin == null)
+                    continue;
+                foreach (KeyValuePair<uint, uint> m in skin.Map)
+                {
+                    if (isArt)
+                        art[m.Key + 0x4000] = m.Value + 0x4000;
+                    else
+                        gumps[m.Key] = m.Value;
+                }
+            }
+            return (gumps, art);
+        }
+
+        private static bool HasGump(uint id) => ExternalImageLoader.Instance.GetGumpFilePath(id) != null;
+
+        private static bool HasArt(uint itemId) => ExternalImageLoader.Instance.GetArtFilePath(itemId + 0x4000) != null;
+
+        public static List<Skin> Available(string kind) => Available(kind, HasGump, HasArt);
+
+        public static string Chosen(string kind)
+        {
+            Skin skin = Effective(kind, Parse(ProfileManager.CurrentProfile?.SlSkins), HasGump, HasArt);
+            return skin?.Key ?? Classic;
+        }
+
+        /// <summary>Applies the current profile's skins: at login (World.CreatePlayer, after the profile loads) and
+        /// after the option changes. Every gump and art whose source changed is dropped from its atlas, so open
+        /// containers and the paperdoll redraw with the new look on the next frame.</summary>
+        public static void Apply()
+        {
+            Dictionary<string, string> choices = Parse(ProfileManager.CurrentProfile?.SlSkins);
+            (Dictionary<uint, uint> gumps, Dictionary<uint, uint> art) = Remaps(choices, HasGump, HasArt);
+
+            List<uint> changedGumps = ExternalImageLoader.Instance.SetGumpRemap(gumps);
+            List<uint> changedArt = ExternalImageLoader.Instance.SetArtRemap(art);
+            var uo = Client.Game?.UO;
+            if (uo?.Gumps != null)
+                foreach (uint id in changedGumps)
+                    uo.Gumps.Invalidate(id);
+            if (uo?.Arts != null)
+                foreach (uint id in changedArt)
+                    uo.Arts.Invalidate(id);
+        }
+
+        /// <summary>The option's choice: saved in the profile at once and applied live.</summary>
+        public static void Choose(string kind, string key)
+        {
+            Profile profile = ProfileManager.CurrentProfile;
+            if (profile == null)
+                return;
+            Dictionary<string, string> choices = Parse(profile.SlSkins);
+            choices[kind] = key;
+            profile.SlSkins = Format(choices);
+            Apply();
+        }
+    }
+}
diff --git a/src/ClassicUO.Client/Game/UI/MyraWindows/Options/Tabs/AppearanceTab.cs b/src/ClassicUO.Client/Game/UI/MyraWindows/Options/Tabs/AppearanceTab.cs
new file mode 100644
index 000000000..bc60d49e3
--- /dev/null
+++ b/src/ClassicUO.Client/Game/UI/MyraWindows/Options/Tabs/AppearanceTab.cs
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: BSD-2-Clause
+// Shattered Legacy patch (cc-P362): Options > Interface > Appearance, the UI skins (Game\Managers\SlSkins.cs). One row
+// per kind: a list, "Classic (stock)" first and the default, then each skin whose files this client has, by its author;
+// and a small preview of the picked skin from its own PNG. Changes apply at once and are saved in the profile.
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using ClassicUO.Assets;
+using ClassicUO.Game.Managers;
+using ClassicUO.Game.UI.MyraWindows.Widgets;
+using Microsoft.Xna.Framework.Graphics;
+using Myra.Graphics2D.TextureAtlases;
+using Myra.Graphics2D.UI;
+
+namespace ClassicUO.Game.UI.MyraWindows.Options.Tabs;
+
+public static class AppearanceTab
+{
+    public const string ClassicLabel = "Classic (stock)";
+    private const int PreviewSize = 96;
+
+    // Preview textures, by file, loaded once per session (a few small PNGs).
+    private static readonly Dictionary<string, Texture2D> _previews = new();
+
+    internal static IOptionSource GetContent()
+    {
+        OptionContent[] rows = SlSkins.Kinds.Select(k => (OptionContent)KindRow(k.Key, k.Label, k.Art)).ToArray();
+        return OptionsUi.Vertical(
+            OptionsUi.VisualContainer(
+                new VisualContainerProps { LabelText = "Shattered Legacy skins" },
+                rows
+            )
+        ).WithSearch(new SearchMetadata("Appearance", ["skin", "appearance", "backpack", "bag", "chest", "crate", "scroll", "shattered legacy"]));
+    }
+
+    /// <summary>The list's labels: Classic, then each available skin as "Label (Author)".</summary>
+    internal static string[] Labels(IReadOnlyList<SlSkins.Skin> skins) =>
+        new[] { ClassicLabel }.Concat(skins.Select(s => s.Label + " (" + s.Author + ")")).ToArray();
+
+    /// <summary>The ID a skin's preview shows: the backpack's open gump, the scroll skin's Flamestrike, else its
+    /// first (for the single-gump kinds, its only) piece.</summary>
+    internal static uint PreviewId(SlSkins.Skin skin)
+    {
+        if (skin.Map.TryGetValue(0x3C, out uint open))
+            return open;
+        if (skin.Map.TryGetValue(0x1F5F, out uint flamestrike))
+            return flamestrike;
+        return skin.Map.Values.First();
+    }
+
+    private static OptionFragment KindRow(string kind, string label, bool art)
+    {
+        List<SlSkins.Skin> skins = SlSkins.Available(kind);
+        string chosen = SlSkins.Chosen(kind);
+        int current = skins.FindIndex(s => s.Key == chosen) + 1;
+        var preview = new Image { MaxWidth = PreviewSize, MaxHeight = PreviewSize };
+        SetPreview(preview, current == 0 ? null : skins[current - 1], art);
+
+        return OptionsUi.Horizontal(
+            Option.ComboBox(
+                label,
+                current,
+                Labels(skins),
+                i =>
+                {
+                    SlSkins.Skin skin = i <= 0 || skins.Count == 0 ? null : skins[Math.Min(i - 1, skins.Count - 1)];
+                    SlSkins.Choose(kind, skin?.Key ?? SlSkins.Classic);
+                    SetPreview(preview, skin, art);
+                },
+                tooltip: skins.Count == 0
+                    ? "No skins for this are installed here; the client draws its own (Classic)."
+                    : "Only you see it. Changes at once, also on open containers. A backpack skin shows with the Containers tab's backpack style on Default.",
+                search: new SearchMetadata(label, Keywords: ["skin", "appearance", kind])
+            ),
+            preview
+        );
+    }
+
+    private static void SetPreview(Image image, SlSkins.Skin skin, bool art)
+    {
+        image.Renderable = null;
+        image.Visible = false;
+        if (skin == null)
+            return;
+
+        uint id = PreviewId(skin);
+        string path = art ? ExternalImageLoader.Instance.GetArtFilePath(id + 0x4000) : ExternalImageLoader.Instance.GetGumpFilePath(id);
+        if (path == null)
+            return;
+
+        if (!_previews.TryGetValue(path, out Texture2D texture) || texture == null || texture.IsDisposed)
+        {
+            texture = ExternalImageLoader.Instance.GetImageTexture(path);
+            _previews[path] = texture;
+        }
+
+        if (texture == null)
+            return;
+
+        image.Renderable = new TextureRegion(texture);
+        image.Visible = true;
+    }
+}
