[Unit]
Description=ClusterF ModernUO shard
Documentation=https://modernuo.com/docs/getting-started/starting/
Wants=network-online.target
After=network-online.target sssd.service

[Service]
Type=simple
User=uo
Group=uo
WorkingDirectory=/opt/uo/modernuo/Distribution
EnvironmentFile=-/etc/uo/modernuo.env
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_NOLOGO=1
ExecStart=/opt/uo/modernuo/Distribution/ModernUO
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=120
LimitNOFILE=65535
SyslogIdentifier=uo

[Install]
WantedBy=multi-user.target
